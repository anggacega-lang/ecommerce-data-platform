{
  "name": "postgres-ecommerce-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "${POSTGRES_USER}",
    "database.password": "${POSTGRES_PASSWORD}",
    "database.dbname": "${POSTGRES_DB}",
    "topic.prefix": "ecommerce",
    "schema.include.list": "public",
    "table.include.list": "public.customers,public.products,public.orders,public.order_items,public.payments,public.inventory",
    "plugin.name": "pgoutput",
    "slot.name": "ecommerce_slot",
    "publication.name": "ecommerce_publication",
    "snapshot.mode": "always",
    "heartbeat.interval.ms": "10000",
    "tombstones.on.delete": "false"
  }
}